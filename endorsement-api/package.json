{
  "name": "endorsement-api",
  "version": "1.0.0",
  "private": true,
  "description": "Servicio traductor de endosos: JSON plano a JSON estructurado del core, guiado por plantillas en BD.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "NODE_ENV=test node --test \"test/**/*.test.js\"",
    "test:coverage": "NODE_ENV=test node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "migration:run": "node scripts/migrate.js",
    "migration:revert": "node scripts/migrate.js --revert"
  },
  "dependencies": {
    "@hapi/hapi": "21.4.14",
    "@hapi/inert": "7.1.3",
    "@hapi/jwt": "3.2.5",
    "@hapi/vision": "7.0.3",
    "hapi-swagger": "17.3.2",
    "joi": "17.13.9",
    "pg": "8.23.1",
    "typeorm": "1.1.3"
  }
}

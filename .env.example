# Copy to .env and adjust. Never commit real credentials.

# PostgreSQL (local Docker)
POSTGRES_DB=endorsements
POSTGRES_USER=endorsements
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Shared JWT settings for endorsement-api and routes-api
JWT_SECRET=change-me-with-a-long-random-value
JWT_ISSUER=interseguritos
JWT_AUDIENCE=interseguritos-apis

# Client credentials accepted by POST /api/v1/auth/token (min 16 chars secret)
API_CLIENT_ID=frontend
API_CLIENT_SECRET=change-me-client-secret

CORS_ORIGINS=http://localhost:5173

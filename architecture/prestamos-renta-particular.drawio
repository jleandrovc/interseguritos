          <mxGeometry x="1120" y="60" width="140" height="860" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="POST /v1/loans · Idempotency-Key: K" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-9" as="offset" /><mxPoint x="110" y="140" as="sourcePoint" /><mxPoint x="290" y="140" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="INSERT loan_request(K) + outbox [1 tx]" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-9" as="offset" /><mxPoint x="290" y="180" as="sourcePoint" /><mxPoint x="470" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="202 {loanId, PENDING}" style="endArrow=open;html=1;dashed=1;fontSize=11;strokeColor=#82b366;fontColor=#4d7a3a;fontStyle=1;" edge="1" parent="1">

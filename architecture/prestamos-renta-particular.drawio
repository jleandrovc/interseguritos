          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6d" value="desembolsa 1 sola vez por K" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="admwr" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="7. Estado final o UNKNOWN&lt;br&gt;(UPDATE … WHERE version = v)" style="endArrow=block;html=1;dashed=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="worker" target="db">
          <mxGeometry x="-0.15" relative="1" as="geometry"><mxPoint y="-16" as="offset" /><Array as="points"><mxPoint x="1079" y="490" /><mxPoint x="717" y="490" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="a8" value="8. Lee UNKNOWN / actualiza" style="endArrow=block;startArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="recon" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a8b" value="8. GET /disbursements/K" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;dashed=1;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="recon" target="admwr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="620" />
              <mxPoint x="1250" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a9" value="9. Cambio de estado" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="worker" target="notify">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="360" /><mxPoint x="1005" y="210" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="a10" value="10. Notifica resultado (push) · o polling / SSE a GET /v1/loans/{id}" style="endArrow=block;html=1;fontSize=11;dashed=1;strokeColor=#82b366;fontColor=#4d7a3a;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="notify" target="client">

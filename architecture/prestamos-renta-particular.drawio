<mxfile host="drawio">
  <diagram id="architecture" name="Arquitectura propuesta">
    <mxGraphModel dx="1600" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Préstamos de Renta Particular · Arquitectura propuesta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;&lt;b&gt;Problema:&lt;/b&gt; INARI responde 502 aunque muchas veces sí desembolsa; el cliente reintenta y el préstamo se paga dos veces.  &lt;b&gt;Solución:&lt;/b&gt; una llave única por solicitud (&lt;b&gt;K&lt;/b&gt;) viaja hasta admwr y un 502 nunca se reintenta a ciegas.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontColor=#0b2547;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="1560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="zClient" value="Cliente" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;arcSize=3;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontColor=#3d5f94;" vertex="1" parent="1">
          <mxGeometry x="20" y="120" width="240" height="470" as="geometry" />
        </mxCell>
        <mxCell id="zCloud" value="Interseguro · Nube" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;arcSize=3;fillColor=#f6fbf4;strokeColor=#82b366;fontColor=#4d7a3a;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="1000" height="470" as="geometry" />
        </mxCell>
        <mxCell id="zOnprem" value="INARI · On-premise" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;arcSize=3;fillColor=#fffaf2;strokeColor=#d79b00;fontColor=#b07800;" vertex="1" parent="1">
          <mxGeometry x="1300" y="120" width="280" height="470" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;App Zona Segura&lt;/b&gt;&lt;br&gt;&lt;br&gt;Crea la llave &lt;b&gt;K&lt;/b&gt; al iniciar la solicitud y bloquea el botón mientras está en proceso.&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 Reintento = misma K&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;spacing=10;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;API Gateway + WAF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Valida el token del cliente y limita reintentos." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;spacing=10;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="180" height="170" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Loans API&lt;/b&gt;&lt;br&gt;&lt;br&gt;Registra la solicitud y responde &lt;b&gt;202 &quot;En proceso&quot;&lt;/b&gt; sin esperar a INARI." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;spacing=10;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="200" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Cola de mensajes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Entrega cada solicitud al worker; si algo falla, la reentrega." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;spacing=10;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="200" width="180" height="170" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Worker de desembolso&lt;/b&gt;&lt;br&gt;&lt;br&gt;Envía el desembolso a admwr con la &lt;b&gt;misma K&lt;/b&gt;.&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 Si recibe 502, NO reintenta&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;spacing=10;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#4d7a3a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="200" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="admwr" value="&lt;b&gt;API admwr&lt;/b&gt;&lt;br&gt;&lt;br&gt;Antes de desembolsar revisa si ya procesó esa K.&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 Misma K = un solo pago&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;spacing=10;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1330" y="200" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;K es única y una póliza solo tiene&lt;br&gt;un préstamo en curso&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 No acepta duplicados&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="490" y="420" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="recon" value="&lt;b&gt;Reconciliador&lt;/b&gt; (cada minuto)&lt;br&gt;&lt;br&gt;Pregunta a admwr qué pasó con cada K pendiente y cierra el estado." style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;arcSize=8;spacing=10;verticalAlign=top;fillColor=#fde7d2;strokeColor=#d97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="430" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="core" value="&lt;b&gt;Core de préstamos&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1360" y="450" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="🔒 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0362c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="188" y="187" width="52" height="26" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="🔒 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0362c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="678" y="405" width="52" height="26" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="🔒 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0362c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="1118" y="187" width="52" height="26" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="🔒 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c0362c;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=13;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="1498" y="187" width="52" height="26" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="①" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1d64e0;fontColor=#12345f;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="gw">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="②" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1d64e0;fontColor=#12345f;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw" target="api">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e3" value="③ guarda" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1d64e0;fontColor=#12345f;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e4" value="④ 202 &quot;En proceso&quot;" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;dashed=1;strokeColor=#2e8b57;fontColor=#1f5f3b;fontStyle=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="api" target="client">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="165" /><mxPoint x="140" y="165" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e5" value="⑤" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;dashed=1;strokeColor=#2e8b57;fontColor=#1f5f3b;fontStyle=1;exitX=1;exitY=0.35;entryX=0.5;entryY=1;" edge="1" parent="1" source="db" target="queue">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="472" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e6" value="⑥" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;dashed=1;strokeColor=#2e8b57;fontColor=#1f5f3b;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="queue" target="worker">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="⑦ K" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1d64e0;fontColor=#12345f;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="worker" target="admwr">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e8" value="⑧ paga 1 vez" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;strokeColor=#1d64e0;fontColor=#12345f;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="admwr" target="core">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e9" value="502 → pendiente" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=3;dashed=1;strokeColor=#c0362c;fontColor=#c0362c;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="worker" target="recon">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e10" value="¿K se pagó?" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;dashed=1;dashPattern=2 3;strokeColor=#d97706;fontColor=#9a5200;fontStyle=1;exitX=1;exitY=0.4;entryX=0;entryY=0.85;" edge="1" parent="1" source="recon" target="admwr">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="482" /><mxPoint x="1250" y="345" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e11" value="resultado" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;dashed=1;dashPattern=2 3;strokeColor=#d97706;fontColor=#9a5200;fontStyle=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="recon" target="db">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e12" value="⑨ notifica el resultado" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;endArrow=block;endFill=1;fontSize=14;labelBackgroundColor=#ffffff;strokeWidth=2.5;dashed=1;strokeColor=#2e8b57;fontColor=#1f5f3b;fontStyle=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="db" target="client">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="495" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="pFlow" value="&lt;b style=&quot;font-size:17px&quot;&gt;Flujo normal&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;①②&lt;/b&gt; La app envía la solicitud con su llave &lt;b&gt;K&lt;/b&gt;; el gateway valida al cliente.&lt;br&gt;&lt;b&gt;③④&lt;/b&gt; La API guarda la solicitud &lt;b&gt;una sola vez&lt;/b&gt; y responde al instante &quot;En proceso&quot;.&lt;br&gt;&lt;b&gt;⑤⑥&lt;/b&gt; La solicitud pasa por la cola hasta el worker.&lt;br&gt;&lt;b&gt;⑦⑧&lt;/b&gt; El worker pide el desembolso a admwr con la misma K y admwr paga.&lt;br&gt;&lt;b&gt;⑨&lt;/b&gt; El cliente recibe la notificación: &lt;b&gt;Desembolsado&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=15;arcSize=4;fillColor=#ffffff;strokeColor=#c9d3e3;" vertex="1" parent="1">
          <mxGeometry x="20" y="620" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p502" value="&lt;b style=&quot;font-size:17px;color:#c0362c&quot;&gt;Si INARI responde 502&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; El worker &lt;b&gt;no reintenta&lt;/b&gt;: marca la solicitud como &lt;b&gt;pendiente&lt;/b&gt; (el pago pudo haberse hecho).&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; El reconciliador pregunta a admwr: &lt;i&gt;&quot;¿la K ya se pagó?&quot;&lt;/i&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; &lt;b&gt;Sí&lt;/b&gt; → se marca Desembolsado y se notifica.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; &lt;b&gt;No&lt;/b&gt; → se reintenta con la &lt;b&gt;misma K&lt;/b&gt;.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Tras 3 intentos sin respuesta → revisión manual." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=15;arcSize=4;fillColor=#fff7f6;strokeColor=#e8a29a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="540" y="620" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="pWhy" value="&lt;b style=&quot;font-size:17px&quot;&gt;Por qué nunca se paga dos veces&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 1&lt;/b&gt;&lt;/font&gt; Si el usuario reintenta, se reenvía la misma K.&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 2&lt;/b&gt;&lt;/font&gt; La base de datos rechaza una K repetida y un segundo préstamo para la misma póliza.&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 3&lt;/b&gt;&lt;/font&gt; Un 502 nunca dispara un reintento ciego.&lt;br&gt;&lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;🔒 4&lt;/b&gt;&lt;/font&gt; admwr paga una sola vez por K, aunque la reciba dos veces." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontSize=15;arcSize=4;fillColor=#ffffff;strokeColor=#c9d3e3;" vertex="1" parent="1">
          <mxGeometry x="1060" y="620" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Leyenda:&lt;/b&gt;  &lt;font color=&quot;#1d64e0&quot;&gt;&lt;b&gt;━━&lt;/b&gt; llamada directa&lt;/font&gt;     &lt;font color=&quot;#2e8b57&quot;&gt;&lt;b&gt;╍╍&lt;/b&gt; en segundo plano&lt;/font&gt;     &lt;font color=&quot;#c0362c&quot;&gt;&lt;b&gt;╍╍&lt;/b&gt; respuesta 502&lt;/font&gt;     &lt;font color=&quot;#d97706&quot;&gt;&lt;b&gt;┄┄&lt;/b&gt; verificación&lt;/font&gt;     &lt;b&gt;Tecnología:&lt;/b&gt; GCP (API Gateway + Cloud Armor, Cloud Run, Cloud SQL PostgreSQL, Pub/Sub, VPN con mTLS, Secret Manager). Equivalente en AWS o Azure." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#15223a;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="885" width="1560" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

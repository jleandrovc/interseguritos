            <Array as="points">
              <mxPoint x="890" y="130" />
              <mxPoint x="100" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Garantías&lt;/b&gt;&lt;br&gt;• Una intención = una K = como máximo un desembolso (BD + admwr)&lt;br&gt;• 502 nunca se muestra al cliente: la UX depende del estado, no de INARI&lt;br&gt;• Reintento solo si admwr confirma que K no se ejecutó" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="190" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sequence" name="3. Secuencia ante 502">

<mxfile host="app.diagrams.net" agent="interseguritos" version="24.0.0">
  <diagram id="as-is" name="1. AS-IS">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b&gt;AS-IS · Préstamos de Renta Particular&lt;/b&gt;&lt;br&gt;Flujo síncrono: el cliente espera en pantalla la respuesta de INARI" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;Zona Segura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="node" value="&lt;b&gt;Backend Node&lt;/b&gt;&lt;br&gt;(espera síncrona)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="310" y="120" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Proxy INARI&lt;/b&gt;&lt;br&gt;corta por timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="120" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="admwr" value="&lt;b&gt;API admwr&lt;/b&gt;&lt;br&gt;VMware INARI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="870" y="120" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="core" value="Core préstamos /&lt;br&gt;Tesorería" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1180" y="110" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1. Solicita&lt;br&gt;desembolso" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="client" target="node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. HTTP&lt;br&gt;síncrono" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="node" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="3. Reenvía" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="proxy" target="admwr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. Desembolsa&lt;br&gt;(aunque el proxy&lt;br&gt;ya cortó)" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="admwr" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. 502 Bad Gateway (timeout)" style="endArrow=block;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=12;fontStyle=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="proxy" target="client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="675" y="240" />
              <mxPoint x="120" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="dup" value="&lt;b&gt;6. El cliente cree que falló y reintenta&lt;/b&gt;&lt;br&gt;→ nueva solicitud sin relación con la anterior&lt;br&gt;→ &lt;b&gt;segundo desembolso de la misma póliza&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="causes" value="&lt;b&gt;Causas raíz&lt;/b&gt;&lt;br&gt;• Sin llave de idempotencia: cada intento es una operación nueva&lt;br&gt;• 502 del proxy ≠ fallo del préstamo: el resultado real es desconocido&lt;br&gt;• Acoplamiento síncrono de la UX a la latencia de INARI&lt;br&gt;• Sin consulta de estado ni reconciliación&lt;br&gt;• Sin control de concurrencia por póliza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="impact" value="&lt;b&gt;Impacto&lt;/b&gt;&lt;br&gt;• Desembolsos duplicados&lt;br&gt;• Recupero de dinero complejo&lt;br&gt;• Pérdida de confianza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1050" y="300" width="280" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="to-be" name="2. TO-BE">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;TO-BE · Desembolso asíncrono e idempotente&lt;/b&gt;&lt;br&gt;El cliente recibe 202 al instante; la misma Idempotency-Key viaja de punta a punta hasta admwr" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="zInternet" value="Internet" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#6c8ebf;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="230" height="780" as="geometry" />
        </mxCell>
        <mxCell id="zCloud" value="GCP · VPC privada (la misma arquitectura aplica en AWS: WAF + API Gateway + ECS/Lambda + RDS + SQS)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f7fbff;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#4d7a3a;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="80" width="970" height="780" as="geometry" />
        </mxCell>
        <mxCell id="zOnprem" value="On-premise · VMware INARI" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fffaf2;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#b07800;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="1260" y="80" width="300" height="780" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Cliente · Zona Segura&lt;/b&gt;&lt;br&gt;Genera Idempotency-Key (UUID) por intención de préstamo&lt;br&gt;Botón bloqueado en PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="170" height="140" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;Cloud Armor (WAF) + API Gateway&lt;/b&gt;&lt;br&gt;OAuth2 / JWT · rate limit por cliente · TLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="340" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;Loans API&lt;/b&gt; (Cloud Run · Node)&lt;br&gt;POST /v1/loans → &lt;b&gt;202&lt;/b&gt; {loanId, PENDING}&lt;br&gt;GET /v1/loans/{id} · SSE de estado&lt;br&gt;Misma key → devuelve la solicitud existente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="330" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Cloud SQL · PostgreSQL&lt;/b&gt;&lt;br&gt;loan_request: UNIQUE(idempotency_key)&lt;br&gt;UNIQUE(policy_id) WHERE estado activo&lt;br&gt;version (lock optimista) · outbox · auditoría" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="540" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bus" value="&lt;b&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;loan.disbursement.requested&lt;br&gt;entrega at-least-once · DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Disbursement Worker&lt;/b&gt; (Cloud Run)&lt;br&gt;Timeout corto · circuit breaker&lt;br&gt;502/timeout → estado UNKNOWN&lt;br&gt;&lt;b&gt;No reintenta a ciegas&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="330" width="195" height="110" as="geometry" />
        </mxCell>
        <mxCell id="vpn" value="&lt;b&gt;Cloud VPN / Interconnect&lt;/b&gt;&lt;br&gt;mTLS · IP allowlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="190" width="195" height="70" as="geometry" />
        </mxCell>
        <mxCell id="recon" value="&lt;b&gt;Reconciliador&lt;/b&gt;&lt;br&gt;Cloud Scheduler + Cloud Run Job (c/1 min)&lt;br&gt;Resuelve UNKNOWN consultando admwr; backoff exponencial; tras N intentos → MANUAL_REVIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="560" width="195" height="120" as="geometry" />
        </mxCell>
        <mxCell id="notify" value="&lt;b&gt;Notificaciones&lt;/b&gt;&lt;br&gt;Pub/Sub loan.status.changed → push / email / SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="800" y="170" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ops" value="&lt;b&gt;Transversal&lt;/b&gt;&lt;br&gt;Secret Manager · IAM (service accounts)&lt;br&gt;Cloud Logging / Monitoring / Trace&lt;br&gt;Alertas: DLQ &gt; 0, UNKNOWN &gt; SLA, circuito abierto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="720" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Proxy INARI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="190" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="admwr" value="&lt;b&gt;API admwr&lt;/b&gt;&lt;br&gt;Acepta Idempotency-Key y la guarda con UNIQUE (deduplica en origen)&lt;br&gt;GET /disbursements/{key} → estado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="330" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="core" value="Core préstamos /&lt;br&gt;Tesorería" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1335" y="560" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="1. POST&lt;br&gt;+ K" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="client" target="gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1b" style="endArrow=block;html=1;" edge="1" parent="1" source="gw" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="2. INSERT … ON CONFLICT (K)&lt;br&gt;+ outbox (misma transacción)" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="3. 202 Accepted {loanId, PENDING}" style="endArrow=block;html=1;dashed=1;fontSize=11;strokeColor=#82b366;fontColor=#4d7a3a;fontStyle=1;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="api" target="client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">

      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="st" value="&lt;b&gt;Secuencia · INARI responde 502 pero admwr sí desembolsa&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">

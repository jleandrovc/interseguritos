              <mxPoint x="135" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a4" value="4. Relay del outbox" style="endArrow=block;html=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="db" target="bus">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="875" y="572" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="a5" value="5. Consume" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="bus" target="worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="6. POST desembolso&lt;br&gt;Idempotency-Key: K" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="worker" target="vpn">
          <mxGeometry relative="1" as="geometry" />
